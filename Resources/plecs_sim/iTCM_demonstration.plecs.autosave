Plecs {
  Name          "iTCM_demonstration"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "0.1"
  Timeout       ""
  Solver        "radau"
  MaxStep       "1e-6"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-6"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "2"
  NegativeSwitchLossMsg "2"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "theta=pi/2;\nVin_rms=230;\nVin_pk=Vin_rms*sqrt(2);\n"
"Vin=Vin_pk*sin(theta);\nVout=400;\nPout=1000;\ni_ac_max=35;\ni_ac_pk=(Pout/Vi"
"n_rms)*sqrt(2);\ni_ac=i_ac_pk*sin(theta);\n\nRth_air = 100;         % Case-to"
"-ambient,forced ventilation (K/W)\nRth_pcb = 3.8;\t       % Case-to-board (K/"
"W)\nRth_pcb_air = 2.2;      % Board-to-ambient , forced ventilation (K/W) was"
" 5 before\n\nTinitGaNFETs = 25;\nTinitSiFETs = 25;\nTamb=25;\nTjunctionGaNFET"
"s = 1.2*TinitGaNFETs;\nTjunctionSiFETs = 1.3*TinitSiFETs;\n\nfs=280e3;\ndeadt"
"ime=17e-9;\n\ni_REF=8;\ni_ZVS=-1e-3;"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
  ExtendedMatrixPrecision "1"
  MatrixSignificanceCheck "2"
