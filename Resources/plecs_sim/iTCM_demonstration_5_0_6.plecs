Plecs {
  Name          "iTCM_demonstration_5_0_6"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "1e-5"
  Timeout       ""
  Solver        "radau"
  MaxStep       "1e-9"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "2.1"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "2"
  NegativeSwitchLossMsg "2"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "theta=(23/12)*pi;\n\nsign=1;\nif(theta>pi && theta<2"
"*pi)\n\tsign=-1;\nend\nVin_rms=230;\nVin_pk=Vin_rms*sqrt(2);\nVin=Vin_pk*sin("
"theta);\nVout=400;\nPout=500;\ni_ac_pk=(Pout/Vin_rms)*sqrt(2);\ni_ac=i_ac_pk*"
"sin(theta);\n\nRth_air = 100;         % Case-to-ambient,forced ventilation (K"
"/W)\nRth_pcb = 3.8;\t       % Case-to-board (K/W)\nRth_pcb_air = 2.2;      % "
"Board-to-ambient , forced ventilation (K/W) was 5 before\n\nTinitGaNFETs = 25"
";\nTinitSiFETs = 25;\nTamb=25;\nTjunctionGaNFETs = 1.2*TinitGaNFETs;\nTjuncti"
"onSiFETs = 1.3*TinitSiFETs;\n\ndeadtime=17e-9;\n\ni_ac_max=30;\ni_REF=2*sign;"
"\ni_ZVS=0*sign;"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
